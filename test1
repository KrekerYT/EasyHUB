-- Перетаскивание окна
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ГЛАВНЫЙ ЦИКЛ РАБОТЫ
local tracersList = {}

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")

    if humanoid then
        local baseSpeed = 16
        local currentMultiplier = MiscConfig.SpeedMultiplier
        
        if MiscConfig.Bhop and humanoid:GetState() == Enum.HumanoidStateType.Freefall then
            currentMultiplier = math.max(currentMultiplier, 1.7)
        end
        
        humanoid.WalkSpeed = baseSpeed * currentMultiplier
    end

    if MiscConfig.NoCollision then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                for _, part in ipairs(player.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local pChar = player.Character
            local hrp = pChar.HumanoidRootPart
            local pHumanoid = pChar:FindFirstChildOfClass("Humanoid")
            
            if ESPConfig.Tracers then
                if not tracersList[player] then
                    local line = Drawing.new("Line")
                    line.Visible = false
                    line.Color = Color3.fromRGB(255, 255, 255)
                    line.Thickness = 1
                    tracersList[player] = line
                end
                
                local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    tracersList[player].From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    tracersList[player].To = Vector2.new(vector.X, vector.Y)
                    tracersList[player].Visible = true
                else
                    tracersList[player].Visible = false
                end
            else
                if tracersList[player] then
                    tracersList[player].Visible = false
                end
            end
            
            if ESPConfig.Chams then
                if not pChar:FindFirstChild("EasyChams") then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "EasyChams"
                    highlight.Adornee = pChar
                    highlight.FillColor = Color3.fromRGB(52, 152, 219)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.Parent = pChar
                end
            else
                if pChar:FindFirstChild("EasyChams") then
                    pChar.EasyChams:Destroy()
                end
            end

            if (ESPConfig.Names or ESPConfig.Health) then
                local head = pChar:FindFirstChild("Head") or hrp
                if not pChar:FindFirstChild("EasyESPInfo") and head then
                    local bg = Instance.new("BillboardGui")
                    bg.Name = "EasyESPInfo"
                    bg.Adornee = head
                    bg.Size = UDim2.new(0, 100, 0, 40)
                    bg.StudsOffset = Vector3.new(0, 2.2, 0)
                    bg.AlwaysOnTop = true
                    bg.Parent = pChar

                    local txt = Instance.new("TextLabel")
                    txt.Name = "InfoText"
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 13
                    txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                    txt.TextStrokeTransparency = 0.4
                    txt.Parent = bg
                end
                
                local bg = pChar:FindFirstChild("EasyESPInfo")
                if bg and bg:FindFirstChild("InfoText") then
                    local textStr = ""
                    if ESPConfig.Names then textStr = textStr .. player.Name .. "\n" end
                    if ESPConfig.Health and pHumanoid then textStr = textStr .. "HP: " .. math.floor(pHumanoid.Health) end
                    bg.InfoText.Text = textStr
                    bg.Enabled = true
                end
            else
                if pChar:FindFirstChild("EasyESPInfo") then
                    pChar.EasyESPInfo:Destroy()
                end
            end
        end
    end
end)
