-- Draggable Window
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Accurate MM2 Role Detection (Fixed false positive detection loop)
local function GetMM2Role(player)
    local character = player.Character
    if not character then return "Innocent" end
    
    -- Check backpack and character tools/items specifically
    local containers = {player:FindFirstChild("Backpack"), character}
    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then
                    local itemName = item.Name:lower()
                    if itemName == "knife" or itemName:find("knife") then
                        return "Murderer"
                    elseif itemName == "gun" or itemName == "revolver" or itemName:find("revolver") or itemName:find("sheriff") then
                        return "Sheriff"
                    end
                end
            end
        end
    end

    return "Innocent"
end

-- MAIN LOOP
local tracersList = {}

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if humanoid then
        local baseSpeed = 16
        local currentMultiplier = MiscConfig.SpeedMultiplier
        
        if MiscConfig.Bhop and humanoid:GetState() == Enum.HumanoidStateType.Freefall then
            currentMultiplier = math.max(currentMultiplier, MiscConfig.BhopMultiplier)
        end
        
        humanoid.WalkSpeed = baseSpeed * currentMultiplier
    end

    if MiscConfig.NoCollision then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                for _, part in ipairs(player.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end
    end

    if MiscConfig.NoClipWall and char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    if MiscConfig.Fly and hrp and humanoid then
        local bv = hrp:FindFirstChild("EasyFlyForce")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "EasyFlyForce"
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Parent = hrp
        end
        
        local moveDir = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveDir = moveDir + Camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveDir = moveDir - Camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveDir = moveDir - Camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveDir = moveDir + Camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveDir = moveDir + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            moveDir = moveDir - Vector3.new(0, 1, 0)
        end
        
        bv.Velocity = moveDir * MiscConfig.FlySpeed
        humanoid.PlatformStand = true
    else
        if hrp and hrp:FindFirstChild("EasyFlyForce") then
            hrp.EasyFlyForce:Destroy()
        end
        if humanoid then
            humanoid.PlatformStand = false
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local pChar = player.Character
            local pHrp = pChar.HumanoidRootPart
            local pHumanoid = pChar:FindFirstChildOfClass("Humanoid")
            local role = GetMM2Role(player)
            
            -- Tracers Logic
            if ESPConfig.Tracers then
                if not tracersList[player] then
                    local line = Drawing.new("Line")
                    line.Visible = false
                    line.Thickness = 1
                    tracersList[player] = line
                end
                
                -- Fixed Tracer Color Logic: White tracer color setting works properly without hardcoded role overriding unless configured
                local tracerColorFinal = ESPConfig.TracersColor
                if ESPConfig.TracersColor == Color3.fromRGB(255, 255, 255) then
                    tracerColorFinal = Color3.fromRGB(255, 255, 255)
                else
                    if role == "Murderer" then
                        tracerColorFinal = ESPConfig.MurderColor
                    elseif role == "Sheriff" then
                        tracerColorFinal = ESPConfig.SheriffColor
                    else
                        tracerColorFinal = ESPConfig.InnocentTracerColor
                    end
                end
                tracersList[player].Color = tracerColorFinal
                
                local vector, onScreen = Camera:WorldToViewportPoint(pHrp.Position)
                if onScreen then
                    tracersList[player].From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    tracersList[player].To = Vector2.new(vector.X, vector.Y)
                    tracersList[player].Visible = true
                else
                    tracersList[player].Visible = false
                end
            else
                if tracersList[player] then
                    tracersList[player].Visible = false
                end
            end
            
            -- Chams & Role ESP Logic
            local activeChams = false
            local chamsColorFinal = ESPConfig.ChamsColor

            if ESPConfig.MurdererESP and role == "Murderer" then
                activeChams = true
                chamsColorFinal = ESPConfig.MurderColor
            elseif ESPConfig.SheriffESP and role == "Sheriff" then
                activeChams = true
                chamsColorFinal = ESPConfig.SheriffColor
            elseif ESPConfig.Chams then
                activeChams = true
                chamsColorFinal = ESPConfig.ChamsColor
            end

            if activeChams then
                local highlight = pChar:FindFirstChild("EasyChams")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "EasyChams"
                    highlight.Adornee = pChar
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.Parent = pChar
                end
                highlight.FillColor = chamsColorFinal
            else
                if pChar:FindFirstChild("EasyChams") then
                    pChar.EasyChams:Destroy()
                end
            end

            -- Names & Health Logic
            if (ESPConfig.Names or ESPConfig.Health or (ESPConfig.MurdererESP and role == "Murderer") or (ESPConfig.SheriffESP and role == "Sheriff")) then
                local head = pChar:FindFirstChild("Head") or pHrp
                local bg = pChar:FindFirstChild("EasyESPInfo")
                if not bg and head then
                    bg = Instance.new("BillboardGui")
                    bg.Name = "EasyESPInfo"
                    bg.Adornee = head
                    bg.Size = UDim2.new(0, 120, 0, 50)
                    bg.StudsOffset = Vector3.new(0, 2.5, 0)
                    bg.AlwaysOnTop = true
                    bg.Parent = pChar

                    local txt = Instance.new("TextLabel")
                    txt.Name = "InfoText"
                    txt.Size = UDim2.new(1, 0, 0, 35)
                    txt.BackgroundTransparency = 1
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 13
                    txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                    txt.TextStrokeTransparency = 0.4
                    txt.Parent = bg

                    local healthBarBg = Instance.new("Frame")
                    healthBarBg.Name = "HealthBarBg"
                    healthBarBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                    healthBarBg.Position = UDim2.new(0.1, 0, 0, 38)
                    healthBarBg.Size = UDim2.new(0.8, 0, 0, 6)
                    healthBarBg.Visible = false
                    healthBarBg.Parent = bg

                    local hbCorner = Instance.new("UICorner")
                    hbCorner.CornerRadius = UDim.new(1, 0)
                    hbCorner.Parent = healthBarBg

                    local healthBarFill = Instance.new("Frame")
                    healthBarFill.Name = "HealthBarFill"
                    healthBarFill.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
                    healthBarFill.Size = UDim2.new(1, 0, 1, 0)
                    healthBarFill.Parent = healthBarBg

                    local hbfCorner = Instance.new("UICorner")
                    hbfCorner.CornerRadius = UDim.new(1, 0)
                    hbfCorner.Parent = healthBarFill
                end
                
                bg = pChar:FindFirstChild("EasyESPInfo")
                if bg then
                    local textStr = ""
                    if ESPConfig.Names then textStr = textStr .. player.Name .. "\n" end
                    if ESPConfig.MurdererESP and role == "Murderer" then textStr = textStr .. "[MURDERER]\n" end
                    if ESPConfig.SheriffESP and role == "Sheriff" then textStr = textStr .. "[SHERIFF]\n" end
                    if ESPConfig.Health and ESPConfig.HealthMode == "Text" and pHumanoid then 
                        textStr = textStr .. "HP: " .. math.floor(pHumanoid.Health) 
                    end
                    bg.InfoText.Text = textStr

                    local hbBg = bg:FindFirstChild("HealthBarBg")
                    if hbBg then
                        if ESPConfig.Health and ESPConfig.HealthMode == "Bar" and pHumanoid then
                            hbBg.Visible = true
                            local hpPercent = math.clamp(pHumanoid.Health / pHumanoid.MaxHealth, 0, 1)
                            hbBg.HealthBarFill.Size = UDim2.new(hpPercent, 0, 1, 0)
                        else
                            hbBg.Visible = false
                        end
                    end
                    bg.Enabled = true
                end
            else
                if pChar:FindFirstChild("EasyESPInfo") then
                    pChar.EasyESPInfo:Destroy()
                end
            end
        end
    end
end)
