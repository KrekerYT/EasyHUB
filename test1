    }, EasyHUB)

    -- top pill tabs (purely cosmetic sections e.g. UI/Theme/Configs)
    function Window:AddTopTab(name, isDefault)
        local btn = create("TextButton", {
            AutoButtonSize = false,
            Size = UDim2.new(0, 68, 1, -6),
            Text = name,
            Font = Theme.Font,
            TextSize = 13,
            TextColor3 = isDefault and Color3.new(1,1,1) or Theme.SubText,
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = isDefault and 0 or 1,
            Parent = TabHolder,
        }, {corner(7)})
        btn.MouseButton1Click:Connect(function()
            for _, child in ipairs(TabHolder:GetChildren()) do
                if child:IsA("TextButton") then
                    tween(child, {BackgroundTransparency = 1})
                    child.TextColor3 = Theme.SubText
                end
            end
            tween(btn, {BackgroundTransparency = 0})
            btn.TextColor3 = Color3.new(1,1,1)
        end)
        return btn
    end

    -- sidebar category (Main, Combat, Settings, etc.)
    function Window:AddCategory(name, icon)
        local isFirst = next(self.Categories) == nil

        local Item = create("TextButton", {
            AutoButtonSize = false,
            Size = UDim2.new(1, 0, 0, 38),
            BackgroundColor3 = Theme.Card,
            BackgroundTransparency = isFirst and 0 or 1,
            Text = "",
            Parent = Sidebar,
        }, {corner(8)})

        local activeBar = create("Frame", {
            Size = UDim2.fromOffset(3, 18),
            Position = UDim2.fromOffset(0, 10),
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = isFirst and 0 or 1,
            Parent = Item,
        }, {corner(2)})

        create("TextLabel", {
            Text = (icon or "•") .. "   " .. name,
            Font = isFirst and Theme.FontBold or Theme.Font,
            TextSize = 13,
            TextColor3 = isFirst and Theme.Text or Theme.SubText,
            TextXAlignment = Enum.TextXAlignment.Left,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -16, 1, 0),
            Position = UDim2.fromOffset(12, 0),
            Name = "Label",
            Parent = Item,
        })

        local Page = create("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Accent,
            CanvasSize = UDim2.new(0,0,0,0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = isFirst,
            Parent = Content,
        })
        local PageLayout = create("UIListLayout", {
            Padding = UDim.new(0, 14),
            Parent = Page,
        })

        Item.MouseButton1Click:Connect(function()
            for _, cat in ipairs(self.Categories) do
                tween(cat.Item, {BackgroundTransparency = 1})
                tween(cat.ActiveBar, {BackgroundTransparency = 1})
                cat.Item.Label.Font = Theme.Font
                cat.Item.Label.TextColor3 = Theme.SubText
                cat.Page.Visible = false
            end
            tween(Item, {BackgroundTransparency = 0})
            tween(activeBar, {BackgroundTransparency = 0})
            Item.Label.Font = Theme.FontBold
            Item.Label.TextColor3 = Theme.Text
            Page.Visible = true
        end)

        local Category = setmetatable({
            Item = Item,
            ActiveBar = activeBar,
            Page = Page,
        }, {__index = EasyHUB})

        function Category:AddSection(sectionName)
            local SectionHeader = create("TextLabel", {
                Text = sectionName,
                Font = Theme.FontBold,
                TextSize = 12,
                TextColor3 = Theme.SubText,
                TextXAlignment = Enum.TextXAlignment.Left,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 16),
                Parent = Page,
            })

            local Card = create("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Theme.Card,
                Parent = Page,
            }, {corner(10), stroke(Theme.Stroke, 1)})
            local CardLayout = create("UIListLayout", {
                Padding = UDim.new(0, 14),
                Parent = Card,
            })
            padding(16).Parent = Card

            local Section = {}

            function Section:AddToggle(cfg)
                cfg = cfg or {}
                local state = cfg.Default or false

                local Row = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Parent = Card,
                })
                create("TextLabel", {
                    Text = cfg.Text or "Toggle",
                    Font = Theme.Font,
                    TextSize = 13,
                    TextColor3 = Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -50, 1, 0),
                    Parent = Row,
                })

                local Switch = create("Frame", {
                    Size = UDim2.fromOffset(38, 20),
                    Position = UDim2.new(1, -38, 0, 0),
                    BackgroundColor3 = state and Theme.Accent or Theme.Sidebar,
                    Parent = Row,
                }, {corner(10), stroke(Theme.Stroke, 1)})
                local Knob = create("Frame", {
                    Size = UDim2.fromOffset(14, 14),
                    Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
                    BackgroundColor3 = Color3.new(1,1,1),
                    Parent = Switch,
                }, {corner(7)})

                local Btn = create("TextButton", {
                    Size = UDim2.fromScale(1,1),
                    BackgroundTransparency = 1,
                    Text = "",
                    Parent = Switch,
                })
                Btn.MouseButton1Click:Connect(function()
                    state = not state
                    tween(Switch, {BackgroundColor3 = state and Theme.Accent or Theme.Sidebar})
                    tween(Knob, {Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)})
                    if cfg.Callback then cfg.Callback(state) end
                end)

                return Switch
            end

            function Section:AddSlider(cfg)
                cfg = cfg or {}
                local min, max = cfg.Min or 0, cfg.Max or 100
                local value = cfg.Default or min

                local Row = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 40),
                    BackgroundTransparency = 1,
                    Parent = Card,
                })
                create("TextLabel", {
                    Text = cfg.Text or "Slider",
                    Font = Theme.Font,
                    TextSize = 13,
                    TextColor3 = Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -50, 0, 18),
                    Parent = Row,
                })
                local ValueLabel = create("TextLabel", {
                    Text = tostring(value),
                    Font = Theme.Font,
                    TextSize = 13,
                    TextColor3 = Theme.SubText,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(0, 50, 0, 18),
                    Position = UDim2.new(1, -50, 0, 0),
                    Parent = Row,
                })

                local Track = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 6),
                    Position = UDim2.fromOffset(0, 26),
                    BackgroundColor3 = Theme.Sidebar,
                    Parent = Row,
                }, {corner(3)})
                local Fill = create("Frame", {
                    Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = Theme.Accent,
                    Parent = Track,
                }, {corner(3)})
                local Knob = create("Frame", {
                    Size = UDim2.fromOffset(14, 14),
                    Position = UDim2.new((value - min) / (max - min), -7, 0.5, -7),
                    BackgroundColor3 = Color3.new(1,1,1),
                    ZIndex = 2,
                    Parent = Track,
                }, {corner(7)})

                local dragging = false
                local function update(inputPos)
                    local rel = math.clamp((inputPos - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                    local val = math.floor(min + (max - min) * rel)
                    Fill.Size = UDim2.new(rel, 0, 1, 0)
                    Knob.Position = UDim2.new(rel, -7, 0.5, -7)
                    ValueLabel.Text = tostring(val)
                    if cfg.Callback then cfg.Callback(val) end
                end

                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        update(input.Position.X)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        update(input.Position.X)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                return Row
            end

            function Section:AddDropdown(cfg)
                cfg = cfg or {}
                local options = cfg.Options or {}
                local selected = cfg.Default or options[1]
                local open = false

                local Row = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Parent = Card,
                })
                create("TextLabel", {
                    Text = cfg.Text or "Dropdown",
                    Font = Theme.Font,
                    TextSize = 13,
                    TextColor3 = Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -120, 1, 0),
                    Parent = Row,
                })

                local Box = create("TextButton", {
                    Size = UDim2.fromOffset(110, 26),
                    Position = UDim2.new(1, -110, 0.5, -13),
                    BackgroundColor3 = Theme.Sidebar,
                    Text = tostring(selected) .. "  ▾",
                    Font = Theme.Font,
                    TextSize = 12,
                    TextColor3 = Theme.Text,
                    Parent = Row,
                }, {corner(7), stroke(Theme.Stroke, 1)})

                local OptionsFrame = create("Frame", {
                    Size = UDim2.new(1, 0, 0, #options * 26),
                    Position = UDim2.fromOffset(0, 30),
                    BackgroundColor3 = Theme.Sidebar,
                    Visible = false,
                    ZIndex = 5,
                    Parent = Box,
                }, {corner(7), stroke(Theme.Stroke, 1)})
                local OptLayout = create("UIListLayout", {Parent = OptionsFrame})

                for _, opt in ipairs(options) do
                    local OptBtn = create("TextButton", {
                        Size = UDim2.new(1, 0, 0, 26),
                        BackgroundTransparency = 1,
                        Text = tostring(opt),
                        Font = Theme.Font,
                        TextSize = 12,
                        TextColor3 = Theme.SubText,
                        ZIndex = 5,
                        Parent = OptionsFrame,
                    })
                    OptBtn.MouseButton1Click:Connect(function()
                        selected = opt
                        Box.Text = tostring(opt) .. "  ▾"
                        OptionsFrame.Visible = false
                        if cfg.Callback then cfg.Callback(opt) end
                    end)
                end

                Box.MouseButton1Click:Connect(function()
                    open = not open
                    OptionsFrame.Visible = open
                end)

                return Row
            end

            function Section:AddButton(cfg)
                cfg = cfg or {}
                local Btn = create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundColor3 = Theme.Sidebar,
                    Text = cfg.Text or "Button",
                    Font = Theme.FontBold,
                    TextSize = 13,
                    TextColor3 = Theme.Text,
                    Parent = Card,
                }, {corner(8), stroke(Theme.Stroke, 1)})
                Btn.MouseEnter:Connect(function() tween(Btn, {BackgroundColor3 = Theme.CardHover}) end)
                Btn.MouseLeave:Connect(function() tween(Btn, {BackgroundColor3 = Theme.Sidebar}) end)
                Btn.MouseButton1Click:Connect(function()
                    if cfg.Callback then cfg.Callback() end
                end)
                return Btn
            end

            function Section:AddLabel(text)
                return create("TextLabel", {
                    Text = text,
                    Font = Theme.Font,
                    TextSize = 12,
                    TextColor3 = Theme.SubText,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 16),
                    Parent = Card,
                })
            end

            return Section
        end

        table.insert(self.Categories, Category)
        return Category
    end

    -- default top tabs like the reference (UI / Theme / Configs)
    Window:AddTopTab("UI", true)
    Window:AddTopTab("Theme", false)
    Window:AddTopTab("Configs", false)

