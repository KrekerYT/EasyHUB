------------------------------------------------------------------
-- OPEN / CLOSE + DRAGGING
------------------------------------------------------------------
local isOpen = false
OpenButton.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    MainFrame.Visible = isOpen
end)
CloseButton.MouseButton1Click:Connect(function()
    isOpen = false
    MainFrame.Visible = false
end)
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.Home or input.KeyCode == Enum.KeyCode.P then
        isOpen = not isOpen
        MainFrame.Visible = isOpen
    end
end)

local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

------------------------------------------------------------------
-- FIXED ESP LOOP (Chams, Tracers, Names, Health)
------------------------------------------------------------------
local tracersList = {}
local namesList = {}

RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local char = player.Character
            local hrp = char.HumanoidRootPart
            local humanoid = char:FindFirstChildOfClass("Humanoid")

            -- Tracers
            if ESPConfig.Tracers then
                if not tracersList[player] then
                    local line = Drawing.new("Line")
                    line.Visible = false
                    line.Color = Color3.fromRGB(255, 255, 255)
                    line.Thickness = 1
                    tracersList[player] = line
                end
                local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    tracersList[player].From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    tracersList[player].To = Vector2.new(vector.X, vector.Y)
                    tracersList[player].Visible = true
                else
                    tracersList[player].Visible = false
                end
            else
                if tracersList[player] then
                    tracersList[player].Visible = false
                end
            end

            -- Chams
            if ESPConfig.Chams then
                if not char:FindFirstChild("EasyChams") then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "EasyChams"
                    highlight.Adornee = char
                    highlight.FillColor = Theme.Accent
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.Parent = char
                end
            else
                if char:FindFirstChild("EasyChams") then
                    char.EasyChams:Destroy()
                end
            end

            -- Names & Health (BillboardGui)
            if (ESPConfig.Names or ESPConfig.Health) then
                local head = char:FindFirstChild("Head") or hrp
                if not char:FindFirstChild("EasyESPInfo") and head then
                    local bg = Instance.new("BillboardGui")
                    bg.Name = "EasyESPInfo"
                    bg.Adornee = head
                    bg.Size = UDim2.new(0, 100, 0, 40)
                    bg.StudsOffset = Vector3.new(0, 2, 0)
                    bg.AlwaysOnTop = true
                    bg.Parent = char

                    local txt = Instance.new("TextLabel")
                    txt.Name = "InfoText"
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 12
                    txt.TextColor3 = Color3.new(1, 1, 1)
                    txt.TextStrokeTransparency = 0.5
                    txt.Parent = bg
                end
                
                local bg = char:FindFirstChild("EasyESPInfo")
                if bg and bg:FindFirstChild("InfoText") then
                    local textStr = ""
                    if ESPConfig.Names then textStr = textStr .. player.Name .. "\n" end
                    if ESPConfig.Health and humanoid then textStr = textStr .. "HP: " .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth) end
                    bg.InfoText.Text = textStr
                    bg.Enabled = true
                end
            else
                if char:FindFirstChild("EasyESPInfo") then
                    char.EasyESPInfo:Destroy()
                end
            end
        end
    end
end)
