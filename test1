--[[
    EasyHUB UI Library (standalone, self-running)
    Run this whole file directly in your executor - it builds and
    shows the window itself, no extra setup needed.

    - Floating "EasyMenu" button, top-center of the screen, draggable.
    - Click it (or press HOME / P) to open/close the main window.
    - Main window is draggable via its top bar.
    - Sidebar: Main, ESP.
]]

local ok, err = pcall(function()

    local TweenService     = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")
    local Players          = game:GetService("Players")

    local LocalPlayer = Players.LocalPlayer
    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

    -- Pick the safest GUI parent available in this environment.
    -- Some executors hide/strip GUIs parented to PlayerGui, so we
    -- prefer gethui() (protected UI layer), then CoreGui, then fall
    -- back to PlayerGui if neither is available.
    local function getGuiParent()
        local success, result = pcall(function()
            if gethui then return gethui() end
        end)
        if success and result then return result end

        success, result = pcall(function()
            return game:GetService("CoreGui")
        end)
        if success and result then return result end

        return PlayerGui
    end

    local GuiParent = getGuiParent()

    --// THEME =====================================================
    local Theme = {
        Background = Color3.fromRGB(18, 19, 24),
        Sidebar    = Color3.fromRGB(15, 16, 20),
        Card       = Color3.fromRGB(24, 25, 31),
        CardHover  = Color3.fromRGB(30, 31, 38),
        Stroke     = Color3.fromRGB(40, 41, 50),
        Accent     = Color3.fromRGB(114, 137, 255),
        Text       = Color3.fromRGB(235, 235, 240),
        SubText    = Color3.fromRGB(150, 152, 165),
        Font       = Enum.Font.GothamMedium,
        FontBold   = Enum.Font.GothamBold,
    }

    --// UTILITIES =================================================
    local function create(class, props, children)
        local inst = Instance.new(class)
        for prop, value in pairs(props or {}) do
            inst[prop] = value
        end
        for _, child in ipairs(children or {}) do
            child.Parent = inst
        end
        return inst
    end

    local function corner(radius)
        return create("UICorner", {CornerRadius = UDim.new(0, radius or 10)})
    end

    local function stroke(color, thickness)
        return create("UIStroke", {
            Color = color or Theme.Stroke,
            Thickness = thickness or 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        })
    end

    local function tween(inst, props, time)
        TweenService:Create(inst, TweenInfo.new(time or 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
    end

    local function makeDraggable(frame, dragHandle)
        local dragging, dragStart, startPos
        dragHandle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = frame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        dragHandle.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
    end

    -- remove any previous instance of the GUI
    local existing = GuiParent:FindFirstChild("EasyHUB_ScreenGui")
    if existing then existing:Destroy() end

    local ScreenGui = create("ScreenGui", {
        Name = "EasyHUB_ScreenGui",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 999,
        Parent = GuiParent,
    })

    local Main = create("Frame", {
        Name = "Main",
        Size = UDim2.fromOffset(650, 420),
        Position = UDim2.new(0.5, -325, 0.5, -210),
        BackgroundColor3 = Theme.Background,
        Visible = false,
        Parent = ScreenGui,
    }, {corner(14), stroke(Theme.Stroke, 1)})

    ------------------------------------------------------------------
    -- FLOATING TOGGLE BUTTON ("EasyMenu")
    ------------------------------------------------------------------
    local FloatBtn = create("TextButton", {
        Name = "EasyMenuToggle",
        Size = UDim2.fromOffset(120, 34),
        Position = UDim2.new(0.5, -60, 0, 12),
        BackgroundColor3 = Theme.Card,
        AutoButtonSize = false,
        Text = "",
        ZIndex = 10,
        Parent = ScreenGui,
    }, {corner(10), stroke(Theme.Stroke, 1)})

    create("Frame", {
        Size = UDim2.fromOffset(8, 8),
        Position = UDim2.fromOffset(14, 13),
        BackgroundColor3 = Theme.Accent,
        Parent = FloatBtn,
    }, {corner(4)})

    create("TextLabel", {
        Text = "EasyMenu",
        Font = Theme.FontBold,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -30, 1, 0),
        Position = UDim2.fromOffset(28, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 10,
        Parent = FloatBtn,
    })

    local function setMenuVisible(visible)
        Main.Visible = visible
    end

    FloatBtn.MouseButton1Click:Connect(function()
        setMenuVisible(not Main.Visible)
    end)
    FloatBtn.MouseEnter:Connect(function() tween(FloatBtn, {BackgroundColor3 = Theme.CardHover}) end)
    FloatBtn.MouseLeave:Connect(function() tween(FloatBtn, {BackgroundColor3 = Theme.Card}) end)
    makeDraggable(FloatBtn, FloatBtn)

    -- HOME and P both toggle the menu
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Enum.KeyCode.Home or input.KeyCode == Enum.KeyCode.P then
            setMenuVisible(not Main.Visible)
        end
    end)

    ------------------------------------------------------------------
    -- TOP BAR
    ------------------------------------------------------------------
    local TopBar = create("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundTransparency = 1,
        Parent = Main,
    })

    local LogoDot = create("Frame", {
        Size = UDim2.fromOffset(34, 34),
        Position = UDim2.fromOffset(16, 11),
        BackgroundColor3 = Theme.Accent,
        Parent = TopBar,
    }, {corner(10)})
    create("TextLabel", {
        Text = "E",
        Font = Theme.FontBold,
        TextSize = 18,
        TextColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Parent = LogoDot,
    })

    create("TextLabel", {
        Text = "EasyHUB",
        Font = Theme.FontBold,
        TextSize = 16,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(60, 10),
        Size = UDim2.fromOffset(200, 18),
        Parent = TopBar,
    })
    create("TextLabel", {
        Text = "Universal Script Hub",
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.SubText,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(60, 28),
        Size = UDim2.fromOffset(200, 16),
        Parent = TopBar,
    })

    local TabHolder = create("Frame", {
        Size = UDim2.fromOffset(220, 34),
        Position = UDim2.fromOffset(220, 11),
        BackgroundColor3 = Theme.Sidebar,
        Parent = TopBar,
    }, {corner(9), stroke(Theme.Stroke, 1)})
    create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 4),
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Parent = TabHolder,
    })
    create("UIPadding", {PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), Parent = TabHolder})

    local function addTopTab(name, isDefault)
        local btn = create("TextButton", {
            AutoButtonSize = false,
            Size = UDim2.new(0, 68, 1, -6),
            Text = name,
            Font = Theme.Font,
            TextSize = 13,
            TextColor3 = isDefault and Color3.new(1, 1, 1) or Theme.SubText,
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = isDefault and 0 or 1,
            Parent = TabHolder,
        }, {corner(7)})
        btn.MouseButton1Click:Connect(function()
            for _, child in ipairs(TabHolder:GetChildren()) do
                if child:IsA("TextButton") then
                    tween(child, {BackgroundTransparency = 1})
                    child.TextColor3 = Theme.SubText
                end
            end
            tween(btn, {BackgroundTransparency = 0})
            btn.TextColor3 = Color3.new(1, 1, 1)
        end)
    end
    addTopTab("UI", true)
    addTopTab("Theme", false)
    addTopTab("Configs", false)

    local SearchBox = create("Frame", {
        Size = UDim2.fromOffset(160, 34),
        Position = UDim2.new(1, -230, 0, 11),
        BackgroundColor3 = Theme.Sidebar,
        Parent = TopBar,
    }, {corner(9), stroke(Theme.Stroke, 1)})
    create("TextBox", {
        PlaceholderText = "Search...",
        Text = "",
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 = Theme.Text,
        PlaceholderColor3 = Theme.SubText,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -16, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = SearchBox,
    })

    local CloseBtn = create("TextButton", {
        Text = "X",
        Font = Theme.FontBold,
        TextSize = 14,
        TextColor3 = Theme.SubText,
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(34, 34),
        Position = UDim2.new(1, -44, 0, 11),
        Parent = TopBar,
    })
    CloseBtn.MouseButton1Click:Connect(function()
        setMenuVisible(false)
    end)

    makeDraggable(Main, TopBar)

    ------------------------------------------------------------------
    -- SIDEBAR + CONTENT
    ------------------------------------------------------------------
    local Sidebar = create("Frame", {
        Size = UDim2.new(0, 160, 1, -56),
        Position = UDim2.fromOffset(0, 56),
        BackgroundColor3 = Theme.Sidebar,
        Parent = Main,
    })
    create("UIListLayout", {Padding = UDim.new(0, 2), Parent = Sidebar})
    create("UIPadding", {PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = Sidebar})

    local Content = create("Frame", {
        Size = UDim2.new(1, -160, 1, -56),
        Position = UDim2.fromOffset(160, 56),
        BackgroundTransparency = 1,
        Parent = Main,
    })
    create("UIPadding", {
        PaddingTop = UDim.new(0, 16),
        PaddingLeft = UDim.new(0, 20),
        PaddingRight = UDim.new(0, 20),
        PaddingBottom = UDim.new(0, 16),
        Parent = Content,
    })

    local categories = {}

    local function addCategory(name, icon)
        local isFirst = #categories == 0

        local Item = create("TextButton", {
            AutoButtonSize = false,
            Size = UDim2.new(1, 0, 0, 38),
            BackgroundColor3 = Theme.Card,
            BackgroundTransparency = isFirst and 0 or 1,
            Text = "",
            Parent = Sidebar,
        }, {corner(8)})

        local activeBar = create("Frame", {
            Size = UDim2.fromOffset(3, 18),
            Position = UDim2.fromOffset(0, 10),
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = isFirst and 0 or 1,
            Parent = Item,
        }, {corner(2)})

        create("TextLabel", {
            Text = (icon and (icon .. "  ") or "") .. name,
            Font = isFirst and Theme.FontBold or Theme.Font,
            TextSize = 13,
            TextColor3 = isFirst and Theme.Text or Theme.SubText,
            TextXAlignment = Enum.TextXAlignment.Left,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -16, 1, 0),
            Position = UDim2.fromOffset(12, 0),
            Name = "Label",
            Parent = Item,
        })

        local Page = create("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Accent,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = isFirst,
            Parent = Content,
        })
        create("UIListLayout", {Padding = UDim.new(0, 14), Parent = Page})

        Item.MouseButton1Click:Connect(function()
            for _, cat in ipairs(categories) do
                tween(cat.Item, {BackgroundTransparency = 1})
                tween(cat.ActiveBar, {BackgroundTransparency = 1})
                cat.Item.Label.Font = Theme.Font
                cat.Item.Label.TextColor3 = Theme.SubText
                cat.Page.Visible = false
            end
            tween(Item, {BackgroundTransparency = 0})
            tween(activeBar, {BackgroundTransparency = 0})
            Item.Label.Font = Theme.FontBold
            Item.Label.TextColor3 = Theme.Text
            Page.Visible = true
        end)

        local cat = {Item = Item, ActiveBar = activeBar, Page = Page}
        table.insert(categories, cat)

        local function addSection(sectionName)
            create("TextLabel", {
                Text = sectionName,
                Font = Theme.FontBold,
                TextSize = 12,
                TextColor3 = Theme.SubText,
                TextXAlignment = Enum.TextXAlignment.Left,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 16),
                Parent = Page,
            })

            local Card = create("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Theme.Card,
                Parent = Page,
            }, {corner(10), stroke(Theme.Stroke, 1)})
            create("UIListLayout", {Padding = UDim.new(0, 14), Parent = Card})
            create("UIPadding", {
                PaddingTop = UDim.new(0, 16), PaddingBottom = UDim.new(0, 16),
                PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16),
                Parent = Card,
            })

            local function addToggle(cfg)
                cfg = cfg or {}
                local state = cfg.Default or false

                local Row = create("Frame", {Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Parent = Card})
                create("TextLabel", {
                    Text = cfg.Text or "Toggle",
                    Font = Theme.Font, TextSize = 13, TextColor3 = Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
                    Size = UDim2.new(1, -50, 1, 0), Parent = Row,
                })

                local Switch = create("Frame", {
                    Size = UDim2.fromOffset(38, 20),
                    Position = UDim2.new(1, -38, 0, 0),
                    BackgroundColor3 = state and Theme.Accent or Theme.Sidebar,
                    Parent = Row,
                }, {corner(10), stroke(Theme.Stroke, 1)})
                local Knob = create("Frame", {
                    Size = UDim2.fromOffset(14, 14),
                    Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    Parent = Switch,
                }, {corner(7)})

                local Btn = create("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = Switch})
                Btn.MouseButton1Click:Connect(function()
                    state = not state
                    tween(Switch, {BackgroundColor3 = state and Theme.Accent or Theme.Sidebar})
                    tween(Knob, {Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)})
                    if cfg.Callback then cfg.Callback(state) end
                end)

                if state and cfg.Callback then cfg.Callback(true) end
                return Switch
            end

            local function addLabel(text)
                return create("TextLabel", {
                    Text = text, Font = Theme.Font, TextSize = 12, TextColor3 = Theme.SubText,
                    TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 16), Parent = Card,
                })
            end

            return {AddToggle = addToggle, AddLabel = addLabel}
        end

        return {AddSection = addSection}
    end

    ------------------------------------------------------------------
    local MainCat = addCategory("Main", "🏠")
    local MainSection = MainCat.AddSection("General")
    MainSection.AddLabel("Welcome to EasyHUB")

    local ESP = addCategory("ESP", "👁")
    local PlayerESP = ESP.AddSection("Player ESP")

    -- ESP toggles - default ON. Empty callback bodies are where you
    -- plug in your own rendering logic (highlights, tracer lines,
    -- billboard labels, etc.) - none is implemented here.
    PlayerESP.AddToggle({Text = "Chams",   Default = true, Callback = function(state) end})
    PlayerESP.AddToggle({Text = "Tracers", Default = true, Callback = function(state) end})
    PlayerESP.AddToggle({Text = "Names",   Default = true, Callback = function(state) end})
    PlayerESP.AddToggle({Text = "Health",  Default = true, Callback = function(state) end})
    PlayerESP.AddToggle({Text = "Box ESP", Default = true, Callback = function(state) end})
    PlayerESP.AddToggle({Text = "Distance",Default = true, Callback = function(state) end})

    print("[EasyHUB] loaded OK, parented to:", GuiParent:GetFullName())
end)

if not ok then
    warn("[EasyHUB] FAILED TO LOAD: " .. tostring(err))
end
