-- Функция создания чекбоксов (тогглов)
local ESPConfig = {Chams = false, Tracers = false, Names = false, Health = false}

local function CreateToggle(name, callback)
    local ToggleButton = Instance.new("TextButton")
    ToggleButton.Parent = ESPPage
    ToggleButton.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
    ToggleButton.Size = UDim2.new(1, -10, 0, 40)
    ToggleButton.AutoButtonColor = false
    ToggleButton.Font = Enum.Font.Gotham
    ToggleButton.Text = ""
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = ToggleButton
    
    local Label = Instance.new("TextLabel")
    Label.Parent = ToggleButton
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 15, 0, 0)
    Label.Size = UDim2.new(0, 200, 1, 0)
    Label.Font = Enum.Font.GothamMedium
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(220, 220, 230)
    Label.TextSize = 14
    Label.TextXAlignment = Enum.TextXAlignment.Left
    
    local Switch = Instance.new("Frame")
    Switch.Parent = ToggleButton
    Switch.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    Switch.Position = UDim2.new(1, -50, 0.5, -10)
    Switch.Size = UDim2.new(0, 40, 0, 20)
    
    local SwitchCorner = Instance.new("UICorner")
    SwitchCorner.CornerRadius = UDim.new(1, 0)
    SwitchCorner.Parent = Switch
    
    local Circle = Instance.new("Frame")
    Circle.Parent = Switch
    Circle.BackgroundColor3 = Color3.fromRGB(200, 200, 210)
    Circle.Position = UDim2.new(0, 2, 0.5, -8)
    Circle.Size = UDim2.new(0, 16, 0, 16)
    
    local CircleCorner = Instance.new("UICorner")
    CircleCorner.CornerRadius = UDim.new(1, 0)
    CircleCorner.Parent = Circle
    
    local toggled = false
    ToggleButton.MouseButton1Click:Connect(function()
        toggled = not toggled
        callback(toggled)
        
        local goalSwitchColor = toggled and Color3.fromRGB(52, 152, 219) or Color3.fromRGB(40, 40, 50)
        local goalCirclePos = toggled and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        
        TweenService:Create(Switch, TweenInfo.new(0.2), {BackgroundColor3 = goalSwitchColor}):Play()
        TweenService:Create(Circle, TweenInfo.new(0.2), {Position = goalCirclePos}):Play()
    end)
end

